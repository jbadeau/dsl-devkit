# LogStream Service Dockerfile
FROM python:3.12-slim@sha256:46cb7cc2877e60fbd5e21a9ae6115c30ace7a077b9f8772da879e4590c18c2e3

# Install dependencies including git for pip install from GitLab
RUN apt-get update && apt-get install -y wget git && \
    GRPC_HEALTH_PROBE_VERSION=v0.4.37 && \
    wget -qO/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-amd64 && \
    chmod +x /bin/grpc_health_probe && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install buildgrid-logstream from GitLab
RUN pip install --no-cache-dir git+https://gitlab.com/BuildGrid/buildgrid-logstream.git

WORKDIR /app

ENTRYPOINT ["bgd-logstream"]
